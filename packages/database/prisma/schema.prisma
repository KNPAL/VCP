generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Owner {
  id String @id @default(uuid()) @db.Uuid
  login String @unique
  passwordHash String
  role String @default("OWNER")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sessions Session[]
}
model Session {
  id String @id @db.VarChar(64)
  ownerId String @db.Uuid
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  csrfHash String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  @@index([expiresAt])
}
model StrategyProfile {
  id String @id @db.VarChar(64)
  version String @unique
  configuration Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model AlertEvent {
 id String @id
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model PatternLifecycle {
 id String @id
 patternId String
 listingId String @db.Uuid
 session DateTime @db.Date
 configHash String
 state String
 asOf DateTime @db.Timestamptz(6)
 evidence Json
 @@unique([patternId,session,configHash])
 @@index([patternId,session],map:"pattern_lifecycle_history")
}
model PatternTransition {
 id String @id
 observationId String @unique
 patternId String
 evidence Json
}
model NotificationOutbox {
 id String @id
 ownerId String @db.Uuid
 eventId String
 channel String
 ruleVersion String
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 @@unique([ownerId,eventId,channel,ruleVersion])
}
model NotificationDelivery {
 outboxId String @id
 state String @default("PENDING")
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
 leaseToken String? @db.Uuid
 leaseUntil DateTime? @db.Timestamptz(6)
 reason String?
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 @@index([state,nextAttemptAt],map:"notification_delivery_due")
}
model NotificationAttempt {
 id String @id @db.Uuid
 outboxId String
 attempt Int
 stage String
 reason String?
 recordedAt DateTime @default(now()) @db.Timestamptz(6)
 @@unique([outboxId,attempt,stage])
}
model InboxNotification {
 id String @id
 ownerId String @db.Uuid
 eventId String
 createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model CandleRevision {
  id String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  session DateTime @db.Date
  scale String
  revision Int
  open Decimal @db.Decimal(20,6)
  high Decimal @db.Decimal(20,6)
  low Decimal @db.Decimal(20,6)
  close Decimal @db.Decimal(20,6)
  volume BigInt
  source String
  receivedAt DateTime @db.Timestamptz(6)
  finalizedAt DateTime? @db.Timestamptz(6)
  adjustmentRevision String?
  @@unique([listingId,session,scale,revision])
}
model IdempotencyRecord {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  key String
  requestHash String @db.VarChar(64)
  response Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([ownerId,key])
}
model IndicatorSnapshot {
  id String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  session DateTime @db.Date
  strategyVersion String
  dataRevision String
  asOf DateTime @db.Timestamptz(6)
  decidedAt DateTime @default(now()) @db.Timestamptz(6)
  evidence Json
  @@unique([listingId,session,strategyVersion,dataRevision])
}
model PatternSnapshot {
  id String @id @default(uuid()) @db.Uuid
  patternId String @db.VarChar(64)
  listingId String @db.Uuid
  session DateTime @db.Date
  dataRevision String
  adjustmentRevision String
  asOf DateTime @db.Timestamptz(6)
  decidedAt DateTime @db.Timestamptz(6)
  evidence Json
  @@unique([patternId,session,dataRevision])
}
model DailyStructureExecution {
  id String @id
  listingId String @db.Uuid
  session DateTime @db.Date
  configHash String @db.VarChar(64)
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([listingId,session])
}
model SchedulerLease {
  scope String @id
  ownerId String @db.Uuid
  fence BigInt
  expiresAt DateTime @db.Timestamptz(6)
}
model SchedulerStatus {
  scope String @id
  evidence Json
  checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model ScheduledScanRequest {
  id String @id @db.Uuid
  scope String
  session DateTime @db.Date
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([scope,session])
}
model ScheduledScanDispatch {
  scanId String @id @db.Uuid
  state String
  reason String?
  checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model EodScanPlan {
  id String @id @db.Uuid
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model EodScanItem {
  id String @id
  scanId String @db.Uuid
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([scanId], map: "EodScanItem_scanId")
}
model EodScanCheckpoint {
  itemId String @id
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model EodScanDispatch {
  itemId String @id
  state String
  checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model PatternReplacement {
  oldId String @id @db.VarChar(64)
  replacedById String @db.VarChar(64)
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model StrategyActivation {
  id String @id @default(uuid()) @db.Uuid
  profileId String @db.VarChar(64)
  activatedAt DateTime @db.Timestamptz(6)
  knownAt DateTime @db.Timestamptz(6)
}
model ScanResult {
  id String @id @db.Uuid
  asOf DateTime @db.Timestamptz(6)
  configHash String @db.VarChar(64)
  dataRevision String
  status String
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([asOf(sort: Desc)])
}
model MarketEvent {
  id String @id @db.VarChar(64)
  logicalId String @db.VarChar(64)
  listingId String @db.Uuid
  session DateTime @db.Date
  type String
  configHash String @db.VarChar(64)
  dataRevision String
  occurredAt DateTime @db.Timestamptz(6)
  observedAt DateTime @db.Timestamptz(6)
  decidedAt DateTime @db.Timestamptz(6)
  evidence Json
  @@unique([logicalId,configHash,dataRevision])
}
model UserSignalDecision {
  id String @id @db.VarChar(64)
  ownerId String @db.Uuid
  marketEventId String @db.VarChar(64)
  state String
  decidedAt DateTime @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  evidence Json
}
model PortfolioJournal {
  id String @id @db.Uuid
  ownerId String @db.Uuid
  sequence Int
  kind String
  occurredAt DateTime @db.Timestamptz(6)
  recordedAt DateTime @db.Timestamptz(6)
  evidence Json
  @@unique([ownerId,sequence])
}
model RawDailyCandle {
  listingId String @db.Uuid
  session DateTime @db.Date
  provider String
  revisionId String @db.Uuid
  contentHash String @db.VarChar(64)
  open Decimal @db.Decimal(20,6)
  high Decimal @db.Decimal(20,6)
  low Decimal @db.Decimal(20,6)
  close Decimal @db.Decimal(20,6)
  volume BigInt
  finalizedAt DateTime @db.Timestamptz(6)
  receivedAt DateTime @db.Timestamptz(6)
  @@id([listingId,session,provider])
}
model CandleChangeOutbox {
  id String @id @db.Uuid
  listingId String @db.Uuid
  session DateTime @db.Date
  provider String
  beforeRevisionId String? @db.Uuid
  afterRevisionId String @unique @db.Uuid
  calendarHash String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model CalendarSnapshot {
  id String @id @db.VarChar(64)
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model CandleQuarantine {
  id String @id @db.Uuid
  listingId String @db.Uuid
  provider String
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model CandleCoverage {
  listingId String @db.Uuid
  provider String
  fromSession DateTime @db.Date
  watermark DateTime? @db.Date
  checkedAt DateTime @db.Timestamptz(6)
  evidence Json
  @@id([listingId,provider])
}
model SourceSnapshot {
  id String @id @db.VarChar(64)
  dataset String
  knownAt DateTime @db.Timestamptz(6)
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model ReadinessProof {
  id String @id @db.VarChar(64)
  gate String
  status String
  probeAt DateTime @db.Timestamptz(6)
  sourceAt DateTime? @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  evidence Json
  @@index([gate,probeAt(sort: Desc)])
}
model Company {
  id String @id @db.Uuid
  isin String @unique @db.VarChar(12)
}
model Listing {
  id String @id @db.Uuid
  companyId String @db.Uuid
  exchange String
}
model InstrumentSnapshot {
  id String @id @db.VarChar(64)
  knownAt DateTime @db.Timestamptz(6)
  sourceReference String
  evidence Json
}
model ListingMapping {
  id String @id @db.VarChar(64)
  snapshotId String @db.VarChar(64)
  listingId String @db.Uuid
  provider String
  token String
  validFrom DateTime @db.Date
  validTo DateTime? @db.Date
  evidence Json
}
model UniverseSnapshot {
  id String @id @db.VarChar(64)
  knownAt DateTime @db.Timestamptz(6)
  evidence Json
}
model ScanUniverseSnapshot {
  scanId String @id @db.Uuid
  knownAt DateTime @db.Timestamptz(6)
  evidence Json
}
model SectorSnapshot {
  id String @id @db.VarChar(64)
  knownAt DateTime @db.Timestamptz(6)
  evidence Json
}
model AdjustmentSnapshot {
  id String @id @db.VarChar(64)
  listingId String @db.Uuid
  scaleSession DateTime @db.Date
  asOf DateTime @db.Timestamptz(6)
  state String
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model AdjustedDailyCandle {
  adjustmentId String @db.VarChar(64)
  rawRevisionId String @db.Uuid
  session DateTime @db.Date
  open Decimal @db.Decimal(20,6)
  high Decimal @db.Decimal(20,6)
  low Decimal @db.Decimal(20,6)
  close Decimal @db.Decimal(20,6)
  volume Decimal @db.Decimal(24,8)
  evidence Json
  @@id([adjustmentId,session])
}
model CorrectionReplayRequest {
  eventId String @id @db.Uuid
  listingId String @db.Uuid
  changedFrom DateTime @db.Date
  dataRevision String @db.Uuid
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model CandleDispatch {
  eventId String @id @db.Uuid
  jobId String?
  state String
  attemptsMade Int
  reason String?
  checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model BrokerCircuit {
  accountKey String @id @db.VarChar(64)
  sessionRevision String @db.Uuid
  open Boolean
  expiresAt DateTime @db.Timestamptz(6)
  reason String?
  verifiedAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
}
model BrokerSessionEvidence {
  accountKey String @db.VarChar(64)
  sessionRevision String @db.Uuid
  verifiedAt DateTime @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  @@id([accountKey,sessionRevision])
}
model BrokerRequestAttempt {
  accountKey String @db.VarChar(64)
  requestId String @db.Uuid
  attempt Int
  at DateTime @db.Timestamptz(6)
  reason String?
  httpStatus Int?
  retryInMs Int?
  @@id([accountKey,requestId,attempt])
}
model HistoricalSyncRun {
  id String @id @db.Uuid
  listingId String @db.Uuid
  provider String
  interval String @default("ONE_DAY")
  fromSession DateTime @db.Date
  toSession DateTime @db.Date
  asOf DateTime @db.Timestamptz(6)
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model HistoricalSyncWindow {
  id String @id @db.Uuid
  runId String @db.Uuid
  parentId String? @db.Uuid
  fromSession DateTime @db.Date
  toSession DateTime @db.Date
  expectedSessions Json
  state String
  attempts Int @default(0)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  reason String?
  report Json?
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([runId,fromSession,toSession])
  @@index([state,nextAttemptAt])
}
model HistoricalSyncAttempt {
  windowId String @db.Uuid
  attempt Int
  leaseToken String @db.Uuid
  outcome String
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@id([windowId,attempt])
}
model HistoricalProbe {
  id String @id @db.Uuid
  accountKey String @db.VarChar(64)
  revision String @db.VarChar(64)
  asOf DateTime @db.Timestamptz(6)
  evidence Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
model BrokerCredential {
 reference String @id @db.Uuid
 accountKey String @db.VarChar(64)
 sessionRevision String @db.Uuid
 keyId String @db.VarChar(64)
 expiresAt DateTime @db.Timestamptz(6)
 envelope Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 @@unique([accountKey,sessionRevision])
}
model BackfillBinding {
 runId String @id @db.Uuid
 credentialReference String @db.Uuid
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model IndicatorReplayReceipt {
 id String @id @db.VarChar(64)
 eventId String @db.Uuid
 adjustmentId String @db.VarChar(64)
 calendarHash String @db.VarChar(64)
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model IndicatorReplayDispatch {
 eventId String @db.Uuid
 adjustmentId String @db.VarChar(64)
 calendarHash String @db.VarChar(64)
 checkedAt DateTime @default(now()) @db.Timestamptz(6)
 state String
 @@id([eventId,adjustmentId,calendarHash])
}

model StructureReplayResult {
 id String @id @db.VarChar(64)
 indicatorReceiptId String @db.VarChar(64)
 instrumentSnapshotId String @db.VarChar(64)
 profileId String
 strengthReplayId String? @db.VarChar(64)
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model RelativeStrengthReplay {
 id String @id @db.VarChar(64)
 indicatorReceiptId String @db.VarChar(64)
 instrumentSnapshotId String @db.VarChar(64)
 profileId String @db.VarChar(64)
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model StructureReplayDispatch {
 strengthReplayId String @id @db.VarChar(64)
 state String
 checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model StrengthReplayPlan {
 id String @id @db.VarChar(64)
 indicatorReceiptId String @db.VarChar(64)
 templateId String? @db.VarChar(64)
 dependencyKey String? @unique @db.VarChar(64)
 sourceReplayId String? @db.VarChar(64)
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 @@unique([indicatorReceiptId,templateId])
}

model StrengthReplayDispatch {
 planId String @id @db.VarChar(64)
 state String
 checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model ReplayContextDiscovery {
 indicatorReceiptId String @id @db.VarChar(64)
 state String
 reason String?
 checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model ReplayDependencyCheck {
 indicatorReceiptId String @id @db.VarChar(64)
 reason String?
 checkedAt DateTime @default(now()) @db.Timestamptz(6)
}
model Watchlist {
 id String @id @db.Uuid
 ownerId String @db.Uuid
 name String
 filters Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 @@unique([ownerId,name])
}
model WatchlistItem {
 watchlistId String @db.Uuid
 listingId String @db.Uuid
 evidence Json
 savedAt DateTime @default(now()) @db.Timestamptz(6)
 @@id([watchlistId,listingId])
}
model WatchlistAudit {
 id String @id @db.Uuid
 ownerId String @db.Uuid
 watchlistId String @db.Uuid
 action String
 evidence Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
}
